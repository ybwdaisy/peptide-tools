---
import Shell from '../../layouts/Shell.astro';
import BackupControls from '../../components/BackupControls.astro';
import '../../styles/products.css';
import { getLocale, localePath, translate } from '../../lib/i18n';
const locale = getLocale(Astro.url.pathname);
const t = (message: string) => translate(message, locale);
---
<Shell title={t('My peptide products')} description={t('Keep your product labels and personal schedules together in this browser.')} active="/products" noindex>
  <div class="product-workspace" id="product-workspace">
    <p id="workspace-loading" class="small" role="status">{t('Reading your local records…')}</p>
    <p id="workspace-error" class="error-message" role="alert"></p>
    <section id="product-overview" aria-labelledby="products-heading">
      <div class="page-heading page-toolbar"><h1 id="products-heading">{t('My products')}</h1><div class="product-add-action" id="product-add-action" hidden><a class="button secondary" data-analytics-action="add_product" href={localePath('/products/new', locale)}>{t('Add another product')}</a></div></div>
      <div id="products-empty" class="product-empty"><h2>{t('Start with a product you already have.')}</h2><a class="button" data-analytics-action="add_product" href={localePath('/products/new', locale)}>{t('Add my first product')}</a></div>
      <div id="product-picker-wrap" class="product-picker" hidden><label for="product-picker">{t('Choose a product')}</label><select id="product-picker" aria-controls="product-detail"></select></div>
      <ul id="product-list" class="product-list" aria-label={t('Saved products')}></ul>
    </section>
    <section id="product-detail" class="product-detail" aria-labelledby="product-detail-name" hidden>
      <div class="page-heading"><h2 id="product-detail-name" tabindex="-1"></h2><p id="product-detail-brand"></p></div>
      <dl id="product-detail-facts" class="label-facts"></dl>
      <div id="product-detail-ingredients" class="product-ingredients" hidden><h2>{t('Ingredients on your label')}</h2><dl id="product-ingredient-facts" class="label-facts"></dl></div>
      <div class="product-detail-actions"><a id="product-calculate-link" data-analytics-action="calculate_product" class="button" href={localePath('/calculator', locale)} hidden>{t('Calculate volume')}</a><button type="button" id="product-calculate-disabled" class="button" disabled aria-describedby="product-detail-notice">{t('Calculate volume')}</button><a id="product-plan-link" data-analytics-action="plan_product" class="text-link" href={localePath('/planner', locale)}>{t('Add to my schedule')}</a><a id="product-edit-link" data-analytics-action="edit_product" class="text-link" href={localePath('/products/new', locale)}>{t('Edit label and concentration')}</a></div>
      <a id="product-reference-link" class="text-link product-reference" href={localePath('/library', locale)} hidden>{t('Read the matching reference')}</a>
      <details id="product-detail-notes" class="optional-help product-information"><summary>{t('Calculation requirements')}</summary><p id="product-detail-notice"></p><p id="product-reference-unmatched" class="small">{t('No exact reference is linked. Check the identity and version on your label.')}</p></details>
      <div id="product-related-schedules" class="product-schedules"><h2>{t('Schedules using this product')}</h2><ul id="product-related-list" class="product-list"></ul><p id="product-related-empty" class="small">{t('No schedule linked yet.')}</p></div>
      <div class="product-record-management"><a href={localePath('/products', locale)} class="text-link">{t('Back to my products')}</a><button type="button" id="product-delete" class="text-button danger">{t('Delete product record')}</button></div>
    </section>
    <section class="product-schedules workspace-schedules" aria-labelledby="product-schedules-heading"><div class="section-toolbar"><h2 id="product-schedules-heading">{t('My schedules')}</h2><a class="text-link" data-analytics-action="open_planner" href={localePath('/planner', locale)}>{t('Open the planner')}</a></div><p id="product-schedules-empty" class="small">{t('No saved schedules.')}</p><ul id="product-schedule-list" class="product-list"></ul></section>
    <details class="workspace-data"><summary id="workspace-data-heading">{t('Your local data')}</summary><p class="small">{t('Your records stay in this browser. Clearing browser data removes them. Keep a separate backup.')}</p><BackupControls exportId="workspace-backup-export" inputId="workspace-backup-import" statusId="workspace-status" label="Restore a local backup" /><button type="button" id="workspace-clear" class="text-button danger">{t('Clear local data')}</button><p id="workspace-status" class="status-message" role="status"></p></details>
  </div>
  <script>import { initProducts } from '../../scripts/products'; initProducts();</script>
</Shell>
