---
import Shell from '../../layouts/Shell.astro';
import { peptides, FDA_RISK_SOURCE } from '../../data/peptides';
import { getLocale, localePath, translate } from '../../lib/i18n';
export function getStaticPaths() { return peptides.map(peptide => ({ params: { slug: peptide.slug }, props: { peptide } })); }
const { peptide } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const t = (message: string) => translate(message, locale);
---
<Shell title={`${peptide.name}: ${t('evidence and half-life context')}`} description={`${peptide.name}: ${t(peptide.summary)} ${t('Read the original sources and limitations; no dose recommendations.')}`} active="/library">
  <nav class="breadcrumb" aria-label={t("Breadcrumb")}><a href={localePath("/library", locale)}>{t("Reference library")}</a></nav>
  <article class="prose">
    <div class="page-heading"><h1>{peptide.name}</h1><p>{peptide.aliases.join('; ')}</p></div>
    <p class="small">{t("Source type:")} {t(peptide.evidence)}{t('. Sources checked')} <time datetime={peptide.checked}>{peptide.checked}</time>.</p>
    <h2>{t("What the cited research examined")}</h2><p>{t(peptide.summary)}</p><p>{t(peptide.limitation)}</p>
    <h2>{t("Reference facts")}</h2>
    <dl class="reference-facts">
      <div><dt>{t("Half-life")}</dt><dd>{t(peptide.halfLife ?? 'Not established for general human use by the cited source.')}{peptide.halfLifeContext && <span class="small">{t(peptide.halfLifeContext)}</span>}</dd></div>
      <div><dt>{t("Human dose range")}</dt><dd>{t("Not provided. This reference does not recommend a human dose.")}</dd></div>
      <div><dt>{t("Administration interval")}</dt><dd>{t("Not established by these sources. A half-life is not a dosing schedule.")}</dd></div>
      <div><dt>{t("Storage")}</dt><dd>{t("Product-specific information required. These sources do not establish a storage specification.")}</dd></div>
    </dl>
    <h2>{t("Safety context")}</h2><p>{t(peptide.risk)}</p><p class="small">{t("Research results and substance listings are not product approvals. The FDA overview distinguishes current Category 2 entries from withdrawn nominations; withdrawal does not establish safety.")}</p>
    <h2>{t("Sources and review method")}</h2>
    <ol class="sources">{peptide.sources.map(source => <li><a href={source.url} target="_blank" rel="noreferrer noopener">{t(source.title)}</a></li>)}<li><a href={FDA_RISK_SOURCE.url} target="_blank" rel="noreferrer noopener">{t(FDA_RISK_SOURCE.title)}</a></li></ol>
    <p>{t("These are bounded summaries of the linked sources, not systematic reviews. An unknown field means that these sources do not establish a general-use value. It does not claim that no other literature exists.")}</p>
    <div class="notice"><p>{t("The")} <a href={localePath("/calculator", locale)}>{t("calculator")}</a> {t("converts values you provide. The")} <a href={localePath("/planner", locale)}>{t("planner")}</a> {t("organizes entries you choose. Neither tool assesses whether a substance or schedule is appropriate.")}</p></div>
  </article>
</Shell>
