---
import Shell from '../../layouts/Shell.astro';
import UnitLinks from '../../components/UnitLinks.astro';
import { peptides } from '../../data/peptides';
import { getLocale, localePath, translate } from '../../lib/i18n';
const locale = getLocale(Astro.url.pathname);
const t = (message: string) => translate(message, locale);
---
<Shell title={t("Peptide reference library")} description={t("Browse 16 source-linked peptide references with study context, pharmacokinetic limitations, and explicit gaps in human evidence.")} active="/library">
  <div class="page-heading"><h1>{t('Reference library')}</h1></div>
  <UnitLinks />
  <div class="search-bar"><label for="library-search">{t("Find a name or alias")}</label><input id="library-search" name="library-search" type="search" autocomplete="off" placeholder={t("e.g. GHK-Cu or Epithalon")} aria-describedby="library-count" /><p id="library-count" class="field-help" role="status">{t('{count} references').replace('{count}', String(peptides.length))}</p></div>
  <ul class="reference-list" id="reference-list">
    {peptides.map(peptide => <li data-reference data-search={`${peptide.name} ${peptide.aliases.join(' ')}`.toLowerCase()}><a href={localePath(`/library/${peptide.slug}`, locale)}><div><strong>{peptide.name}</strong><p>{peptide.aliases[0]}</p></div><p class="reference-summary">{t(peptide.summary)}</p><span class="evidence-tag">{t(peptide.evidence)}</span></a></li>)}
  </ul>
  <p id="library-empty" class="notice" hidden>{t("No matching reference. Try another name or clear the search.")}</p>
  <div class="notice prose"><p>{t("“Human study” describes the source, not a safety endorsement. A study-specific half-life is not a dosing interval. These entries do not recommend doses or product storage instructions.")}</p></div>
  <script>
    import { ui } from '../../lib/i18n';
    const search = document.querySelector<HTMLInputElement>('#library-search')!;
    const references = Array.from(document.querySelectorAll<HTMLElement>('[data-reference]'));
    search.addEventListener('input', () => {
      const value = search.value.toLowerCase().trim(); let count = 0;
      references.forEach(row => { row.hidden = !row.dataset.search!.includes(value); if (!row.hidden) count++; });
      document.querySelector('#library-count')!.textContent = ui('{count} references', { count });
      document.querySelector<HTMLElement>('#library-empty')!.hidden = count > 0;
    });
  </script>
</Shell>
