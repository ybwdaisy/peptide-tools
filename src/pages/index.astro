---
import Shell from '../layouts/Shell.astro';
import Calculator from '../components/Calculator.astro';
import { getLocale, localePath, translate } from '../lib/i18n';
const locale = getLocale(Astro.url.pathname);
const t = (message: string) => translate(message, locale);
---
<Shell title={t("Peptide calculator and local planner")} description={t("Convert a specified dose to volume, read sourced peptide references, and organize a private browser-local schedule.")}>
  <div class="page-heading"><h1>{t("Peptide arithmetic, made clear.")}</h1><p>{t("Convert your inputs. Read the evidence. Keep your schedule local.")}</p></div>
  <Calculator compact />
  <section class="next-tools" aria-label={t("More tools")}>
    <a href={localePath("/library", locale)}><div><h2>{t("Read the reference library")}</h2><p>{t("Study context, source links and what remains unknown.")}</p></div><span aria-hidden="true">↗</span></a>
    <a href={localePath("/planner", locale)}><div><h2>{t("Build your own schedule")}</h2><p>{t("A calendar you fill in, save locally and export.")}</p></div><span aria-hidden="true">↗</span></a>
  </section>
</Shell>
