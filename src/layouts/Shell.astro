---
import '../styles/app.css';
import { getLocale, localePath, translate } from '../lib/i18n';
interface Props { title: string; description: string; active?: string; noindex?: boolean }
const { title, description, active, noindex = false } = Astro.props;
const isProduction = import.meta.env.VERCEL_ENV === 'production';
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? '';
const verification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const canonical = new URL(localePath(Astro.url.pathname, getLocale(Astro.url.pathname)), Astro.site);
const nav = [['My products', '/products'], ['Reference library', '/library']] as const;
const locale = getLocale(Astro.url.pathname);
const t = (message: string) => translate(message, locale);
---
<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f0f1ee" />
    <meta name="referrer" content="no-referrer" />
    {(noindex || !isProduction) && <meta name="robots" content="noindex, nofollow" />}
    {verification && <meta name="google-site-verification" content={verification} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(localePath(Astro.url.pathname, 'en'), Astro.site)} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(localePath(Astro.url.pathname, 'zh'), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(localePath(Astro.url.pathname, 'en'), Astro.site)} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/ibm-plex-sans.ttf" as="font" type="font/ttf" crossorigin />
    <meta name="apple-mobile-web-app-title" content="Peptide Tools" />
    <meta property="og:title" content={`${title} | Peptide Tools`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <title>{title} | Peptide Tools</title>
  </head>
  <body data-ga-id={gaId} data-analytics-origin="https://peptides.ybwdaisy.com" data-analytics-enabled={String(isProduction && /^G-[A-Z0-9]+$/.test(gaId))}>
    <a class="skip-link" href="#main">{t("Skip to content")}</a>
    <header class="site-header container">
      <a class="brand" href={localePath("/", locale)} aria-label={t("Peptide Tools home")}>Peptide<span>Tools</span></a>
      <nav aria-label={t("Main navigation")}>{nav.map(([label, href]) => <a href={localePath(href, locale)} aria-current={active === href ? 'page' : undefined}>{t(label)}</a>)}</nav>
      <div class="header-tools"><span class="local-label">{t("Works in your browser")}</span><nav class="language-switch" aria-label={t('Language')}><a href={localePath(Astro.url.pathname, 'en')} lang="en" hreflang="en" data-language="en" aria-current={locale === 'en' ? 'true' : undefined}>EN</a><a href={localePath(Astro.url.pathname, 'zh')} lang="zh-CN" hreflang="zh-CN" data-language="zh" aria-current={locale === 'zh' ? 'true' : undefined}>中文</a></nav></div>
    </header>
    <main id="main" class="container"><slot /></main>
    <footer class="site-footer container">
      <p>{t("Tools for arithmetic and personal organization. No medical advice.")}</p>
      <nav aria-label={t("Footer")}><a href={localePath('/calculator', locale)}>{t('Calculator')}</a><a href={localePath('/planner', locale)}>{t('Protocol planner')}</a><a href={localePath("/privacy", locale)}>{t("Privacy")}</a><a href={localePath("/disclaimer", locale)}>{t("Disclaimer")}</a><button type="button" class="text-button" data-open-consent>{t("Analytics preferences")}</button></nav>
      <p id="analytics-status" class="small">{t("Optional analytics: off.")}</p>
    </footer>
    <section id="analytics-choice" class="consent-bar" aria-label={t("Optional analytics preferences")} hidden>
      <div><strong>{t("Help improve these tools?")}</strong><p>{t("Optional usage analytics excludes your inputs. Tools work either way.")} <a href={localePath("/privacy", locale)}>{t("Details")}</a></p></div>
      <div class="actions"><button type="button" class="button secondary" data-consent="denied">{t("No thanks")}</button><button type="button" class="button secondary" data-consent="granted">{t("Allow analytics")}</button></div>
    </section>
    <noscript><div class="noscript-note container">{t("JavaScript is needed for calculations and local schedules. Reference pages remain readable. Analytics is off.")}</div></noscript>
    <script>
      import { initAnalytics } from '../scripts/analytics';
      import { initLanguage } from '../scripts/language';
      initLanguage();
      initAnalytics();
    </script>
  </body>
</html>
<style is:global>html, body { overflow-x: clip; }</style>
