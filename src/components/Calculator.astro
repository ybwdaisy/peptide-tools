---
import { getLocale, translate } from '../lib/i18n';
import ConcentrationSource from './ConcentrationSource.astro';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const t = (message: string) => translate(message, locale);
---
<section id="calculator-product" class="product-context" hidden aria-label={t('Product for this calculation')}>
  <div class="calculator-product-label">
    <h2 id="calculation-product-name"></h2><p id="calculation-product-spec" class="small"></p>
    <p id="calculation-product-note" class="small"></p>
  </div>
  <div class="calculator-product-controls">
    <div id="calculation-basis-wrap" hidden><label for="calculation-basis">{t('My entered amount refers to')}</label><select id="calculation-basis"><option value="">{t('Choose an ingredient')}</option></select></div>
    <a id="calculation-product-edit" href={locale === 'zh' ? '/zh/products' : '/products'}>{t('Review this product')}</a>
  </div>
</section>
<div class:list={['calculator-workbench', { compact }]}>
  <form id="calculator-form" class="calculator-inputs" novalidate>
    <div class="calculator-label-inputs">
      <ConcentrationSource prefix="calculator-source" errorId="calculator-error" />
      <div class="calculator-concentration">
        <label for="concentration">{t("Concentration")} <span class="unit-label">mg/mL</span></label>
        <input id="concentration" name="concentration" inputmode="decimal" type="text" autocomplete="off" required aria-describedby="concentration-help calculator-error" placeholder={t("e.g. 2")} />
      </div>
      <label id="calculation-review" class="checkbox-label" hidden><input id="confirm-updated-product" name="confirmUpdatedProduct" type="checkbox" />{t('I checked the updated product and these calculation inputs.')}</label>
    </div>
    <div class="dose-row">
      <div><label for="dose">{t("Target dose")}</label><input id="dose" name="dose" type="text" inputmode="decimal" autocomplete="off" required placeholder={t("Your specified dose")} aria-describedby="calculator-error" /></div>
      <div><label for="unit">{t("Unit")}</label><select id="unit" name="unit"><option value="mcg">mcg</option><option value="mg">mg</option></select></div>
    </div>
    <label class="checkbox-label"><input type="checkbox" name="useSyringe" id="use-syringe" /> {t("Show a U-100 syringe scale")}</label>
    <fieldset id="syringe-fields" class="syringe-fields" disabled hidden>
      <legend>{t("Match your actual device")}</legend>
      <div class="two-columns"><div><label for="capacity">{t("Capacity")}</label><select id="capacity" name="capacity" aria-describedby="calculator-error"><option value="0.3">{t("0.3 mL")}</option><option value="0.5">{t("0.5 mL")}</option><option value="1" selected>{t("1 mL")}</option></select></div><div><label for="increment">{t("Smallest graduation")}</label><select id="increment" name="increment"><option value="0.5">{t("0.5 marking")}</option><option value="1" selected>{t("1 marking")}</option><option value="2">{t("2 markings")}</option></select></div></div>
      <p class="field-help">{t("U-100 markings measure volume here, not peptide activity.")}</p>
    </fieldset>
    <div class="calculator-submit">
      <p id="calculator-error" class="error-message" role="alert"></p>
      <button class="button" type="submit" disabled>{t("Calculate volume")}</button>
    </div>
  </form>
  <section class="calculator-output" aria-label={t("Calculation result")} aria-live="polite" aria-atomic="true">
    <h2>{t("Calculated volume")}</h2>
    <div id="result-empty" class="result-empty"><span class="result-placeholder">… <span>mL</span></span></div>
    <div id="calculator-result" hidden>
      <p class="volume"><output id="result-volume"></output> <span>mL</span></p>
      <p id="result-equation" class="equation"></p>
      <div id="result-markings" class="markings" hidden><p><output id="markings-value"></output> {t("U-100 markings")}</p><p id="graduation-note" class="field-help" hidden></p></div>
      <p id="result-unit-note" class="field-help"></p>
      <div id="blend-result" hidden><h3>{t('Ingredient amounts in this volume')}</h3><ul id="blend-amounts"></ul></div>
      <a id="calculation-plan-link" class="button secondary" hidden href={locale === 'zh' ? '/zh/planner' : '/planner'}>{t('Use in my schedule')}</a>
      <form id="save-calculation-form" class="save-calculation" novalidate>
        <div><label for="calculation-name">{t('Calculation name')}</label><input id="calculation-name" name="calculationName" maxlength="80" autocomplete="off" /></div>
        <button class="button secondary" type="submit" disabled>{t('Save calculation')}</button>
      </form>
    </div>
    <p id="calculation-storage-status" class="status-message" role="status"></p>
    <div class="result-context"><p>{t("This tool converts units. It does not determine an appropriate dose or whether a product is safe to use.")}</p></div>
  </section>
</div>
<section id="saved-calculations" class="saved-calculations" hidden><div class="section-toolbar"><h2>{t('Saved calculations')}</h2><a href={locale === 'zh' ? '/zh/products#workspace-data-heading' : '/products#workspace-data-heading'}>{t('Back up local data')}</a></div><ul id="saved-calculation-list" class="saved-list"></ul></section>
<details class="prose explanation">
  <summary>{t("How the arithmetic works")}</summary>
  <p id="concentration-help">{t("Use the concentration verified for your specific solution.")}</p>
  <p>{t("Convert mcg to mg by dividing by 1,000. Divide the resulting mg by the concentration in mg/mL to obtain mL. For an explicitly selected U-100 syringe, multiply mL by 100 to obtain scale markings.")}</p>
  <p>{t("International Units (IU) express biological activity for specific substances. This tool does not convert peptide mass to IU. It does not calculate a dose from body weight, infer concentration from a product name, or round a result to a usable injection.")}</p>
  <p>{t("Unit confusion can cause serious dosing errors. See the")} <a href="https://www.fda.gov/drugs/human-drug-compounding/fda-alerts-health-care-providers-compounders-and-patients-dosing-errors-associated-compounded" title={t("FDA explanation of dose, volume and syringe-unit errors")} target="_blank" rel="noreferrer noopener">{t('FDA dosing-error alert')}</a>.</p>
</details>
<script>
  import { initCalculator } from '../scripts/calculator';
  initCalculator();
</script>
